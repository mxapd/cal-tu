# Example vdirsyncer config for cal-tui.
# Copy to ~/.config/vdirsyncer/config, then run:
#   vdirsyncer discover && vdirsyncer sync

[general]
status_path = "~/.local/share/vdirsyncer/status/"

# --- Radicale: all your own calendars, two-way --------------------------------
[pair radicale]
a = "radicale_local"
b = "radicale_remote"
collections = ["from a", "from b"]
metadata = ["color", "displayname"]
conflict_resolution = null   # report conflicts instead of picking a side

[storage radicale_local]
type = "filesystem"
path = "~/.local/share/calendars/"
fileext = ".ics"

[storage radicale_remote]
type = "caldav"
url = "https://radicale.example.org/"
username = "me"
password.fetch = ["command", "pass", "radicale"]

# --- University feed: read-only subscription ---------------------------------
[pair uni]
a = "uni_local"
b = "uni_remote"
collections = null
conflict_resolution = "b wins"

[storage uni_local]
type = "filesystem"
path = "~/.local/share/calendars/uni/"
fileext = ".ics"

[storage uni_remote]
type = "http"
url = "https://university.example/timetable.ics"
